---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { chapterMeta } from '../content.config';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// 按年 → 月 两级聚合
type Group = { year: string; months: { ym: string; posts: typeof posts }[] };
const groups: Group[] = [];

for (const p of posts) {
  const d = p.data.pubDate;
  const year = String(d.getFullYear());
  const ym = `${year}-${String(d.getMonth() + 1).padStart(2, '0')}`;

  let g = groups.find((x) => x.year === year);
  if (!g) {
    g = { year, months: [] };
    groups.push(g);
  }
  let m = g.months.find((x) => x.ym === ym);
  if (!m) {
    m = { ym, posts: [] };
    g.months.push(m);
  }
  m.posts.push(p);
}

const total = posts.length;
const span = posts.length
  ? `${posts[posts.length - 1].data.pubDate.getFullYear()} – ${posts[0].data.pubDate.getFullYear()}`
  : '';
---

<Base title="时间线 — lggyx 的博客">
  <section class="tl">
    <h1>时间线</h1>
    <p class="tl-sub">共 {total} 篇 · {span}</p>

    {groups.map((g) => (
      <section class="year">
        <div class="year-head">
          <span class="year-num">{g.year}</span>
          <span class="year-count">{g.months.reduce((n, m) => n + m.posts.length, 0)} 篇</span>
        </div>
        {g.months.map((m) => (
          <div class="month">
            <div class="month-head">
              <span class="month-num">{m.ym.split('-')[1]} 月</span>
              <span class="month-bar" />
            </div>
            <ul class="month-posts">
              {m.posts.map((p) => (
                <li>
                  <a href={`/posts/${p.id}/`}>
                    <span class="day">{String(p.data.pubDate.getDate()).padStart(2, '0')}</span>
                    <span class="t">{p.data.title}</span>
                    {p.data.legacy && <span class="badge">旧文</span>}
                  </a>
                  <span class="ch">{chapterMeta[p.data.chapter].label}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))}
  </section>
</Base>

<style>
  .tl { padding: 32px 0; }
  .tl h1 { margin: 0 0 4px; }
  .tl-sub { color: var(--text-muted); font-size: 14px; margin: 0 0 32px; }

  .year { margin-bottom: 36px; }
  .year-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--border);
    margin-bottom: 16px;
  }
  .year-num { font-size: 2em; font-weight: 700; font-variant-numeric: tabular-nums; }
  .year-count { color: var(--text-muted); font-size: 13px; }

  .month { margin-bottom: 22px; }
  .month-head { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
  .month-num { font-size: 14px; font-weight: 600; color: var(--text-muted); }
  .month-bar { flex: 1; height: 1px; background: var(--border); }

  .month-posts { list-style: none; padding: 0; margin: 0; }
  .month-posts li {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 5px 0;
    font-size: 14.5px;
  }
  .month-posts a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    text-decoration: none;
    color: var(--text);
    flex: 1;
    min-width: 0;
  }
  .month-posts a:hover .t { color: var(--accent); }
  .day {
    color: var(--text-muted);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
    width: 22px;
    flex-shrink: 0;
  }
  .t { flex: 1; min-width: 0; }
  .ch {
    font-size: 11.5px;
    color: var(--text-muted);
    flex-shrink: 0;
  }
  .badge { font-size: 10.5px; }

  @media (max-width: 560px) {
    .ch { display: none; }
  }
</style>
