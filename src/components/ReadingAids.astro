---
/**
 * 阅读辅助组件（挂载于文章页）
 *  - 阅读进度条：顶部细线
 *  - TOC：随滚动高亮当前章节，点击平滑滚动
 *  - 回到顶部：滚动过 hero 后出现
 *
 * 交互全用原生 JS，零依赖。Astro 的 <script> 默认打包并去重。
 */
---

{/* 阅读进度：1px 细线，Anthropic 风格（无彩色） */}
<div class="reading-progress" data-reading-progress>
  <div class="reading-progress-bar"></div>
</div>

{/* 回到顶部：无底色的极简按钮，与全站细线语言一致 */}
<button class="back-to-top" data-back-to-top aria-label="回到顶部" title="回到顶部">
  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>

<script>
  // ── 阅读进度条 ──
  const bar = document.querySelector<HTMLElement>('[data-reading-progress] .reading-progress-bar');
  const article = document.querySelector<HTMLElement>('.post-content');

  if (bar && article) {
    let ticking = false;
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const passed = -rect.top;
      const pct = total > 0 ? Math.min(100, Math.max(0, (passed / total) * 100)) : 0;
      bar.style.transform = `scaleX(${pct / 100})`;
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) {
        window.requestAnimationFrame(update);
        ticking = true;
      }
    }, { passive: true });
    update();
  }

  // ── 回到顶部 ──
  const btn = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
  if (btn) {
    const toggle = () => {
      btn.classList.toggle('is-visible', window.scrollY > 600);
    };
    window.addEventListener('scroll', toggle, { passive: true });
    btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
    toggle();
  }

  // ── TOC：当前章节高亮 ──
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc a[href^="#"]');
  if (tocLinks.length > 0) {
    const headings = [...document.querySelectorAll<HTMLElement>('.post-content h2, .post-content h3')];
    const byId = new Map<string, HTMLAnchorElement>();
    tocLinks.forEach((a) => {
      const id = decodeURIComponent(a.getAttribute('href')!.slice(1));
      byId.set(id, a);
    });

    const spy = () => {
      let activeIdx = 0;
      headings.forEach((h, i) => {
        if (h.getBoundingClientRect().top < 120) activeIdx = i;
      });
      tocLinks.forEach((a) => a.classList.remove('is-active'));
      const current = headings[activeIdx];
      if (current) {
        byId.get(current.id)?.classList.add('is-active');
      }
    };

    let spyTicking = false;
    window.addEventListener('scroll', () => {
      if (!spyTicking) {
        window.requestAnimationFrame(() => { spy(); spyTicking = false; });
        spyTicking = true;
      }
    }, { passive: true });
    spy();
  }
</script>
