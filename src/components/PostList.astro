---
import type { CollectionEntry } from 'astro:content';
import { chapterMeta } from '../content.config';

interface Props {
  posts: CollectionEntry<'posts'>[];
  showChapter?: boolean;
}

const { posts, showChapter = false } = Astro.props;

// 列表页显示「年-月」而非完整日期，减少视觉噪音
function ym(d: Date) {
  return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
}
---

<ul class="post-list">
  {posts.map((post) => (
    <li>
      <a href={`/posts/${post.id}/`} class="post-item">
        <span class="post-date">{ym(post.data.pubDate)}</span>
        <span class="post-title">
          {post.data.title}
          {post.data.legacy && <span class="badge">旧文</span>}
        </span>
        {showChapter && (
          <span class="post-chapter">{chapterMeta[post.data.chapter].label}</span>
        )}
      </a>
    </li>
  ))}
</ul>

<style>
  .post-list { list-style: none; padding: 0; margin: 0; }
  .post-list li { border-bottom: 1px solid var(--border); }
  .post-list li:last-child { border-bottom: none; }

  .post-item {
    display: flex;
    align-items: baseline;
    gap: 14px;
    padding: 12px 4px;
    text-decoration: none;
    color: var(--text);
  }
  .post-item:hover .post-title { color: var(--accent); }

  .post-date {
    font-size: 13px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    width: 62px;
  }
  .post-title { flex: 1; font-size: 15px; }
  .post-chapter {
    font-size: 12px;
    color: var(--text-muted);
    background: var(--badge-bg);
    padding: 1px 8px;
    border-radius: 999px;
    flex-shrink: 0;
  }
  .badge { font-size: 11px; }

  @media (max-width: 560px) {
    .post-chapter { display: none; }
    .post-date { width: 54px; font-size: 12px; }
  }
</style>
