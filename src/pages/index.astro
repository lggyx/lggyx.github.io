---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { chapterMeta, chapters } from '../content.config';
import PostList from '../components/PostList.astro';

// 时间倒序：新文章在前
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const recent = posts.slice(0, 12);
const navChapters = chapters.filter((c) => c !== 'archive');

// 每章篇数，用于章节入口显示
const countByChapter = chapters.reduce<Record<string, number>>((acc, c) => {
  acc[c] = posts.filter((p) => p.data.chapter === c).length;
  return acc;
}, {});

// 简短的自我介绍（放首页顶部，详情去 about 页）
const intro = {
  line1: 'lggyx — 全栈 AI infra 学习者',
  line2: '这里是我的技术笔记：算法备赛、Python、前端与项目记录。',
};
---

<Base>
  <section class="intro">
    <h1>{intro.line1}</h1>
    <p>{intro.line2}</p>
    <p class="intro-links">
      <a href="/about/">关于我</a>
      <a href="https://lggyx.vercel.app" target="_blank" rel="noopener">个人网站</a>
    </p>
  </section>

  <section class="chapters">
    {navChapters.map((c) => (
      countByChapter[c] > 0 && (
        <a href={`/chapters/${c}/`} class="chapter-card">
          <span class="chapter-name">{chapterMeta[c].label}</span>
          <span class="chapter-count">{countByChapter[c]} 篇</span>
        </a>
      )
    ))}
  </section>

  <section class="recent">
    <div class="section-head">
      <h2>最近文章</h2>
      <a href="/timeline/" class="more">全部 {posts.length} 篇 →</a>
    </div>
    <PostList posts={recent} />
  </section>
</Base>

<style>
  .intro { padding: 40px 0 28px; }
  .intro h1 { font-size: 1.9em; margin: 0 0 10px; }
  .intro p { color: var(--text-muted); margin: 6px 0; }
  .intro-links { display: flex; gap: 18px; font-size: 14px; margin-top: 12px; }

  .chapters {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
    margin: 8px 0 36px;
  }
  .chapter-card {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text);
    background: var(--bg-soft);
  }
  .chapter-card:hover { border-color: var(--accent); }
  .chapter-name { font-weight: 600; font-size: 14px; }
  .chapter-count { font-size: 12px; color: var(--text-muted); }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 14px;
  }
  .section-head h2 { margin: 0; border: none; font-size: 1.25em; }
  .more { font-size: 13px; text-decoration: none; color: var(--text-muted); }
  .more:hover { color: var(--accent); }
</style>
