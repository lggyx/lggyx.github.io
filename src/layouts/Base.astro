---
// 全局布局：头部导航 + 内容区 + 页脚（Anthropic 风格：细线、大留白、无圆角装饰）
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: string; // 当前页 key，用于导航高亮
}

const {
  title = 'lggyx 的博客',
  description = '算法备赛、技术笔记与项目记录',
  current = '',
} = Astro.props;

const nav = [
  { key: 'home', label: '首页', href: '/' },
  { key: 'timeline', label: '时间线', href: '/timeline/' },
  { key: 'about', label: '关于', href: '/about/' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-nav">
      <div class="container">
        <a href="/" class="nav-brand">lggyx</a>
        <nav class="nav-links">
          {nav.map((n) => (
            <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>
              {n.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main class={current === 'home' ? 'container has-aurora' : 'container'}>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <span>© 2024–2026 lggyx</span>
        <span>
          <a href="https://github.com/lggyx" target="_blank" rel="noopener">GitHub</a>
          {' · '}
          <a href="https://lggyx.vercel.app" target="_blank" rel="noopener">个人网站</a>
        </span>
      </div>
    </footer>
  </body>
</html>
