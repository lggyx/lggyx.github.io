---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { chapterMeta, chapters } from '../content.config';
import PostList from '../components/PostList.astro';

// 时间倒序：新文章在前
const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const recent = posts.slice(0, 12);
const navChapters = chapters.filter((c) => c !== 'archive');

// 每章篇数，用于章节入口显示
const countByChapter = chapters.reduce<Record<string, number>>((acc, c) => {
  acc[c] = posts.filter((p) => p.data.chapter === c).length;
  return acc;
}, {});
---

<Base current="home">
  <!-- Hero：左大标题 + 右侧正文（Anthropic Research 页的标志性双栏） -->
  <section class="hero">
    <h1>lggyx 的博客</h1>
    <div>
      <p class="hero-body">
        这里是我的技术笔记：算法备赛的知识点与真题、Python
        与框架入门、以及一些项目开发记录。文章多为 2024 年的存量内容，
        仅供参考。
      </p>
      <div class="hero-links">
        <a href="/about/">关于我</a>
        <a href="https://lggyx.vercel.app" target="_blank" rel="noopener">个人网站</a>
      </div>
    </div>
  </section>

  <!-- 章节入口：5 列横排 + 竖细线分隔，与 Anthropic Research 团队栏同构 -->
  <section class="chapter-grid">
    {navChapters.map((c) => (
      countByChapter[c] > 0 && (
        <a href={`/chapters/${c}/`}>
          <span class="chapter-name">{chapterMeta[c].label}</span>
          <span class="chapter-desc">{chapterMeta[c].desc}</span>
          <span class="chapter-count">{countByChapter[c]} 篇</span>
        </a>
      )
    ))}
  </section>

  <section class="recent">
    <div class="section-head">
      <h2>最近文章</h2>
      <a href="/timeline/" class="more">全部 {posts.length} 篇 →</a>
    </div>
    <PostList posts={recent} />
  </section>
</Base>
